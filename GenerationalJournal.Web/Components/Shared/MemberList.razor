@using GenerationalJournal.Web.Models

<div class="member-list">
    @if (Members.Count == 0)
    {
        <p class="text-muted mb-0">No members yet.</p>
    }
    else
    {
        <ul class="list-group">
            @foreach (var member in Members)
            {
                <li class="list-group-item d-flex align-items-center flex-wrap gap-2">
                    <div class="me-auto">
                        <div class="fw-semibold">
                            @member.FullName
                            <span class="badge @RoleBadgeClass(member.Role) ms-1">@member.Role</span>
                        </div>
                        <div class="small text-muted">@member.Email</div>
                        @if (!string.IsNullOrWhiteSpace(member.RelationshipDescription))
                        {
                            <div class="small">@member.RelationshipDescription</div>
                        }
                    </div>
                    <div class="small text-muted text-nowrap">
                        Joined @member.JoinedAt.ToString("MMM d, yyyy")
                    </div>
                    @if (CanRemove(member))
                    {
                        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => OnRemove.InvokeAsync(member)">Remove</button>
                    }
                </li>
            }
        </ul>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public List<FamilyMemberResponse> Members { get; set; } = new();

    [Parameter]
    public bool IsAdmin { get; set; }

    [Parameter]
    public Guid CurrentUserId { get; set; }

    [Parameter]
    public EventCallback<FamilyMemberResponse> OnRemove { get; set; }

    private bool CanRemove(FamilyMemberResponse member) =>
        IsAdmin && member.UserId != CurrentUserId;

    private static string RoleBadgeClass(string role) =>
        role.Equals("Admin", StringComparison.OrdinalIgnoreCase)
            ? "text-bg-warning"
            : "text-bg-secondary";
}
